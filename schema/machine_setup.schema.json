{
  "$defs": {
    "autoUpdate": {
      "additionalProperties": false,
      "description": "Daily OS-timer auto-update (at XOR cron; daily only in v1)",
      "properties": {
        "at": {
          "description": "Daily local time HH:MM",
          "type": "string"
        },
        "cron": {
          "description": "5-field cron; v1 accepts daily M H * * * only",
          "type": "string"
        }
      },
      "type": "object"
    },
    "commandEntry": {
      "description": "One Command entry (exactly one kind key)",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "copy": {
              "additionalProperties": false,
              "properties": {
                "ignore": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "src": {
                  "type": "string"
                },
                "sudo": {
                  "default": false,
                  "type": "boolean"
                },
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "src",
                "target"
              ],
              "type": "object"
            }
          },
          "required": [
            "copy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "symlink": {
              "additionalProperties": false,
              "properties": {
                "force": {
                  "default": false,
                  "type": "boolean"
                },
                "ignore": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "src": {
                  "type": "string"
                },
                "sudo": {
                  "default": false,
                  "type": "boolean"
                },
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "src",
                "target"
              ],
              "type": "object"
            }
          },
          "required": [
            "symlink"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "clone": {
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "target"
              ],
              "type": "object"
            }
          },
          "required": [
            "clone"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "run": {
              "additionalProperties": false,
              "properties": {
                "commands": {
                  "$ref": "#/$defs/stringOrVec"
                },
                "env": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "install": {
                  "$ref": "#/$defs/stringOrVec"
                },
                "quiet": {
                  "default": false,
                  "type": "boolean"
                },
                "shell": {
                  "enum": [
                    "bash",
                    "zsh",
                    "powershell"
                  ],
                  "type": "string"
                },
                "uninstall": {
                  "$ref": "#/$defs/stringOrVec"
                },
                "update": {
                  "$ref": "#/$defs/stringOrVec"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "run"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "machine_setup": {
              "additionalProperties": false,
              "properties": {
                "config": {
                  "type": "string"
                },
                "force": {
                  "default": false,
                  "description": "Bypass History skip in the nested Runner",
                  "type": "boolean"
                },
                "task": {
                  "type": "string"
                },
                "with_deps": {
                  "default": false,
                  "description": "When task is set, also run transitive depends_on (like CLI --with-deps)",
                  "type": "boolean"
                }
              },
              "required": [
                "config"
              ],
              "type": "object"
            }
          },
          "required": [
            "machine_setup"
          ],
          "type": "object"
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "description": "Path that must exist (only_if) or exist to skip (skip_if)",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "env": {
              "type": "string"
            }
          },
          "required": [
            "env"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "oneOf": [
                {
                  "enum": [
                    "install",
                    "update",
                    "uninstall"
                  ],
                  "type": "string"
                },
                {
                  "items": {
                    "enum": [
                      "install",
                      "update",
                      "uninstall"
                    ],
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              ]
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        }
      ]
    },
    "conditions": {
      "oneOf": [
        {
          "$ref": "#/$defs/condition"
        },
        {
          "items": {
            "$ref": "#/$defs/condition"
          },
          "type": "array"
        }
      ]
    },
    "osFilter": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "stringOrVec": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "task": {
      "additionalProperties": false,
      "properties": {
        "auto_update": {
          "$ref": "#/$defs/autoUpdate"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/commandEntry"
          },
          "type": "array"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "only_if": {
          "$ref": "#/$defs/conditions"
        },
        "os": {
          "$ref": "#/$defs/osFilter"
        },
        "parallel": {
          "default": false,
          "type": "boolean"
        },
        "retry": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "retry_delay_secs": {
          "default": 1,
          "description": "Seconds to wait between retry attempts",
          "minimum": 0,
          "type": "integer"
        },
        "skip_if": {
          "$ref": "#/$defs/conditions"
        }
      },
      "required": [
        "commands"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/timopruesse/machine_setup/main/schema/machine_setup.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_for_updates": {
      "default": true,
      "description": "When false, skip the post-command self update-check notice",
      "type": "boolean"
    },
    "default_shell": {
      "default": "bash",
      "enum": [
        "bash",
        "zsh",
        "powershell"
      ],
      "type": "string"
    },
    "num_threads": {
      "description": "Concurrency gate size (default: physical CPUs - 1)",
      "minimum": 1,
      "type": "integer"
    },
    "parallel": {
      "default": false,
      "description": "Run all Tasks in parallel",
      "type": "boolean"
    },
    "tasks": {
      "additionalProperties": {
        "$ref": "#/$defs/task"
      },
      "description": "Named Tasks",
      "type": "object"
    },
    "temp_dir": {
      "description": "Directory for temp files and History (default: ~/.machine_setup)",
      "type": "string"
    }
  },
  "required": [
    "tasks"
  ],
  "title": "machine_setup Config document",
  "type": "object"
}
